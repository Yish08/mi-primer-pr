# Entorno de ejecución (development | test | production)
NODE_ENV=development

# El frontend (CRA) ocupa el puerto 3000, por eso la API usa el 4000 en local.
PORT=4000

# URL pública del frontend permitida por CORS (sin barra final; acepta varios orígenes separados por coma)
CORS_ORIGIN=http://localhost:3000

# Cadena de conexión a MongoDB (local en desarrollo, MongoDB Atlas mongodb+srv://... en producción)
MONGODB_URI=mongodb://localhost:27017/ecommerce-db-test

# Secretos para firmar tokens JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=secret_token
JWT_REFRESH_TOKEN=secret_refresh_token
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Credenciales de Cloudinary (para subida de imágenes de productos en /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
